    "%@ still to download: iCloud was too slow to send them. Mosaic Companion asks again later." : {
      "comment" : "What is still to download, then why",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora da scaricare: %@. iCloud è stato troppo lento a inviarli: Mosaic Companion li richiede più tardi."
