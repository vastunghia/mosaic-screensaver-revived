        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se azzeri i limiti, Mosaic riparte da zero e scarica subito %#@missing@, circa %2$lld MB. Su un piano dati a consumo, il download viene conteggiato. Foto conserva le copie nella libreria finché non le serve lo spazio."
          },
          "substitutions" : {
            "missing" : {
              "argNum" : 1,
