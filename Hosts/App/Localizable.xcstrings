            "state" : "translated",
            "value" : "Mai"
          }
        }
      }
    },
    "No album chosen is the whole library; several are combined." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun album scelto vuol dire tutta la libreria; più album si sommano."
