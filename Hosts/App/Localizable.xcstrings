    },
    "Mosaic turns your photographs into an endless zoom: every photograph turns out to be one tile of a mosaic, which makes up another photograph, which is one tile of the next mosaic." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mosaic verwandelt deine Fotos in einen endlosen Zoom: Jedes Foto entpuppt sich als Stein eines Mosaiks, das ein anderes Foto bildet, das wiederum ein Stein des nächsten Mosaiks ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mosaic convierte tus fotos en un zoom infinito: cada foto resulta ser una tesela de un mosaico, que forma otra foto, que a su vez es una tesela del mosaico siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mosaic transforme vos photos en un zoom sans fin : chaque photo se révèle être une tesselle d’une mosaïque, qui compose une autre photo, elle-même tesselle de la mosaïque suivante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic trasforma le tue foto in uno zoom senza fine: ogni foto si rivela una tessera di un mosaico, che compone un’altra foto, che è una tessera del mosaico successivo."
          }
        }
      }
    },
