    "%@ still to download: iCloud was too slow to send them. Mosaic Companion asks again later." : {
      "comment" : "What is still to download, then why",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Noch zu laden: %@. iCloud hat sie zu langsam gesendet: Mosaic Companion fragt später erneut an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pendientes de descargar: %@. iCloud ha tardado demasiado en enviarlos: Mosaic Companion los volverá a pedir más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Encore à télécharger : %@. iCloud a été trop lent à les envoyer : Mosaic Companion les redemandera plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora da scaricare: %@. iCloud è stato troppo lento a inviarli: Mosaic Companion li richiede più tardi."
          }
        }
      }
    },
    "%@ still to download: the limit of %lld a day or %lld a week is reached. Mosaic Companion goes on as soon as it allows." : {
      "comment" : "What is still to download, then the daily and weekly download limits that hold it back",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Noch zu laden: %1$@. Das Limit von %2$lld pro Tag oder %3$lld pro Woche ist erreicht: Mosaic Companion macht weiter, sobald es wieder möglich ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ still to download: the limit of %2$lld a day or %3$lld a week is reached. Mosaic Companion goes on as soon as it allows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pendientes de descargar: %1$@. Se ha alcanzado el límite de %2$lld al día o %3$lld a la semana: Mosaic Companion seguirá en cuanto sea posible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Encore à télécharger : %1$@. La limite de %2$lld par jour ou %3$lld par semaine est atteinte : Mosaic Companion reprendra dès que possible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora da scaricare: %1$@. È stato raggiunto il limite di %2$lld al giorno o %3$lld alla settimana: Mosaic Companion riprende appena possibile."
          }
        }
      }
    },
    "%@ still to download: the network is metered (a hotspot, or Low Data Mode)." : {
      "comment" : "What is still to download, then why",
