{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ and %@" : {
      "comment" : "Close-ups and tiles still to download, as in “3 sharp close-ups and 5 sharper tiles”",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ and %2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e %@"
          }
        }
      }
    },
    "%@ still to download: Mosaic Companion tries again later." : {
      "comment" : "What is still to download, with no particular reason",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora da scaricare: %@. Mosaic Companion riprova più tardi."
          }
        }
      }
    },
    "%@ still to download: iCloud stopped answering. Mosaic Companion tries again at %@." : {
      "comment" : "What is still to download, then why and when it is tried again",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ still to download: iCloud stopped answering. Mosaic Companion tries again at %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora da scaricare: %1$@. iCloud ha smesso di rispondere: Mosaic Companion riprova alle %2$@."
          }
        }
      }
    },
    "%@ still to download: iCloud stopped answering. Mosaic Companion tries again later." : {
