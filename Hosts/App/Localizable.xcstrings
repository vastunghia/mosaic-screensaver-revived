    "It opens again from there. The screen saver and the login item need it to stay in one place; the downloaded copy can then go in the Bin." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die App öffnet sich dann dort neu. Der Bildschirmschoner und das Anmeldeobjekt brauchen einen festen Ort; die geladene Kopie kann danach in den Papierkorb."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se vuelve a abrir desde allí. El salvapantallas y el ítem de inicio necesitan que esté siempre en el mismo sitio; después, la copia descargada puede ir a la Papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elle se rouvre depuis cet emplacement. L’économiseur d’écran et l’ouverture avec la session ont besoin qu’elle reste au même endroit ; la copie téléchargée peut ensuite aller à la corbeille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si riapre da lì. Il salvaschermo e l’elemento login hanno bisogno che resti in un posto solo; la copia scaricata può poi andare nel Cestino."
          }
        }
      }
    },
    "Last changed on %@, next on %@. The screen saver shows the current photographs until the new ones are ready." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
